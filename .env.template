# ──────────────────────────────────────────────────────────
#  Code Tutor Agent — 环境变量模板
#  复制为 .env 并填入真实值：
#    cp .env.template .env
# ──────────────────────────────────────────────────────────

# ── 模型配置（至少配一组） ──

# Agnes (默认，推荐用这个)
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://api.sensenova.com/v1
AGNES_API_KEY=your_agnes_key_here

# 或 SenseNova
# SENSENOVA_MODEL=sensenova-v1
# SENSENOVA_MODEL1=sensenova-v1
# SENSENOVA_BASE_URL=https://api.sensenova.com/v1
# SENSENOVA_API_KEY=your_key_here

# 或 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 数据目录 ──
# DB_PATH=data/code_tutor.db

# ── Judge0 判题服务（WSL Docker） ──
# 设置后自动使用 Judge0 沙箱替代本地 subprocess
JUDGE0_URL=http://localhost:2358

# ── LangSmith 分布式追踪（可选，强烈推荐）──
# 免费额度：5000 traces/月，14天保留。注册地址：https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=code-tutor-agent

# ── 管理页面密码 ──
# 设置一个强密码用于访问前端的管理页面 Tab
ADMIN_PASSWORD=change_me_admin_password

# ── 会话 TTL 自动清理（可选）──
# 超过 TTL 未活跃的会话会被后台任务自动删除
# SESSION_TTL_HOURS=168          # 默认 168 小时（7 天）
# SESSION_CLEANUP_INTERVAL_MINUTES=60  # 清理任务运行间隔，默认 60 分钟