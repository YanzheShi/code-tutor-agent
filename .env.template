# ──────────────────────────────────────────────────────────
#  Code Tutor Agent — 环境变量模板
#  复制为 .env 并填入真实值：
#    cp .env.template .env
# ──────────────────────────────────────────────────────────

# ── 模型配置（至少配一组） ──

# Agnes (默认，推荐用这个)
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://api.sensenova.com/v1
AGNES_API_KEY=your_agnes_key_here

# 或 SenseNova
# SENSENOVA_MODEL=sensenova-v1
# SENSENOVA_MODEL1=sensenova-v1
# SENSENOVA_BASE_URL=https://api.sensenova.com/v1
# SENSENOVA_API_KEY=your_key_here

# 或 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 数据目录 ──
# DB_PATH=data/code_tutor.db