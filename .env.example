# ── Code Tutor Agent — 环境变量配置示例 ──
# 复制此文件为 .env 并填入你的配置信息
# cp .env.example .env

# ============================================
# LLM 配置（唯一必需项：其他变量都有默认值，可不改）
# ============================================
# 主模型——任何 OpenAI 兼容 API 均可
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://your-provider/v1
LLM_API_KEY=sk-your-api-key

# 备用模型（可选，用于 benchmark 等场景）
# LLM_MODEL_ALT=deepseek-chat
# LLM_BASE_URL_ALT=https://api.deepseek.com
# LLM_API_KEY_ALT=sk-your-deepseek-key

# ============================================
# LangSmith 可观测性（可选，强烈推荐）
# ============================================
# 免费注册：https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxx
# LANGSMITH_PROJECT=code-tutor-agent
# LANGSMITH_FEEDBACK=true

# ============================================
# 管理页面密码（可选）
# ============================================
# ADMIN_PASSWORD=change_me_admin_password

# ============================================
# CORS 允许的前端来源（有默认值，一般不用改）
# 若前端跑在其他端口（如 vite dev 5173），在此追加
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 管理页面密码（可选）
# ============================================
# ADMIN_PASSWORD=change_me_admin_password

# ============================================
# Judge0 判题沙箱（有默认值，一般不用改）
# 判题后端切换：self=本地 subprocess runner；judge0=Judge0 沙箱
# ============================================
JUDGE_BACKEND=self
# Judge0 资源限制（512MB，5秒超时，对齐 TIMEOUT_SECONDS）
JUDGE0_MEM_LIMIT=512000000
JUDGE0_CPU_TIME_LIMIT=5
# 下面两个密码 compose 已有默认值，如需自定义再改
# JUDGE0_REDIS_PASSWORD=ct_redis_pwd
# JUDGE0_POSTGRES_PASSWORD=ct_pg_pwd

# ============================================
# 会话管理（可选）
# ============================================
# 会话 TTL（小时，默认 168 即 7 天）
# SESSION_TTL_HOURS=168

# 自动清理间隔（分钟，默认 60）
# SESSION_CLEANUP_INTERVAL_MINUTES=60

# Checkpoint DB 路径（可选）
# CHECKPOINT_DB_PATH=data/checkpoints.db

# ============================================
# 轨迹分析 LLM 重试（可选）
# 被 RPM/TPM 限流时：增大 base_delay 到 60s，让配额在下一分钟窗口内恢复
# ============================================
# 最大重试次数（默认 4）
# TRACE_RETRY_ATTEMPTS=4
# 首次重试等待秒数（默认 30，指数退避 30/60/120…）
# TRACE_RETRY_BASE_DELAY_SECONDS=30

# ============================================
# 题目生成（可选）
# ============================================
# 生成超时秒数（默认 120）
# GENERATION_TIMEOUT_SECONDS=120

# ============================================
# 联网搜索（搜索 MCP，可选）
# 导师辅导对话的联网搜索工具。仅在设置了 SEARCH_MCP_TOKEN 时才暴露给导师。
#
# 本接入是“厂商无关”的：任何以 Streamable HTTP 暴露、带 Bearer 鉴权、
# 且提供兼容搜索工具的 MCP 服务都能用，只需改下面的 URL / token / 工具名，
# 代码不用动。
#
# ── 用法 A：自建搜索网关（默认，工具名 web_search）──
#   SEARCH_MCP_URL=http://127.0.0.1:8080/mcp
#   SEARCH_MCP_TOKEN=网关发给本应用的 Bearer token
#   （SEARCH_MCP_TOOL_NAME 可省略，默认 web_search）
#
# ── 用法 B：指向你自己的 / 第三方的搜索 MCP（如 Tavily）──
#   把 URL、token 换成对方服务即可；若对方工具名不是 web_search，
#   再用 SEARCH_MCP_TOOL_NAME 指定（见下）。
#
# ⚠️ 官方原版 Tavily MCP（tavily-mcp）通常以 stdio 方式运行、工具名是
#   tavily-search、且 key 放在服务端环境变量里——与本接入默认的
#   “HTTP + Bearer + web_search”契约不同。直接用它需要：
#   (a) 套一层 HTTP 网关重新暴露兼容工具，或
#   (b) 把它包成 HTTP Streamable MCP 后，设 SEARCH_MCP_TOOL_NAME=tavily-search。
# ============================================
# 搜索 MCP 端点（Streamable HTTP）
# SEARCH_MCP_URL=http://127.0.0.1:8080/mcp
# Bearer token（自建网关按应用签发；第三方服务换成对方给的 key）
# SEARCH_MCP_TOKEN=your-search-mcp-token
# 要调用的搜索工具名（默认 web_search；对接官方 Tavily 时一般为 tavily-search）
# SEARCH_MCP_TOOL_NAME=web_search
# 单次调用超时秒数（默认 20）
# SEARCH_MCP_TIMEOUT_SECONDS=20