{
  "title": "两数之和",
  "description": "给定一个整数数组 nums 和一个整数目标值 target，请你在该数组中找出和为目标值 target 的那两个整数，并返回它们的数组下标。\n\n你可以假设每种输入只会对应一个答案。但是，数组中同一个元素不能使用两遍。\n\n你可以按任意顺序返回答案。",
  "difficulty": "easy",
  "topic": "数组",
  "examples": [
    "[2,7,11,15]\n9",
    "[3,2,4]\n6",
    "[3,3]\n6",
    "[1]\n5",
    "[-1,-2,-3,-4,-5]\n-8",
    "[5,5,5,5]\n10",
    "[100000]\n200000",
    "[]\n0",
    "[-3,3]\n0",
    "[1,5,3]\n4"
  ],
  "constraints": [
    "数组长度在 1 到 100 之间",
    "数组元素为整数"
  ],
  "test_cases": [
    {
      "input": "[2,7,11,15]\n9",
      "expected_output": "[0, 1]",
      "is_hidden": true,
      "explanation": "因为 nums[0] + nums[1] == 9 ，返回 [0, 1] 。"
    },
    {
      "input": "[3,2,4]\n6",
      "expected_output": "[1, 2]",
      "is_hidden": false,
      "explanation": "因为 nums[1] + nums[2] == 6 ，返回 [1, 2] 。"
    },
    {
      "input": "[3,3]\n6",
      "expected_output": "[0, 1]",
      "is_hidden": false,
      "explanation": "因为 nums[0] + nums[1] == 6 ，返回 [0, 1] 。"
    },
    {
      "input": "[1]\n5",
      "expected_output": "[]",
      "is_hidden": false,
      "explanation": "数组只有一个元素，无法找到两个数之和为目标值。"
    },
    {
      "input": "[-1,-2,-3,-4,-5]\n-8",
      "expected_output": "[2, 4]",
      "is_hidden": true,
      "explanation": "-3 + (-5) = -8 ，下标为 2 和 4。"
    },
    {
      "input": "[5,5,5,5]\n10",
      "expected_output": "[0, 1]",
      "is_hidden": false,
      "explanation": "第一个 5 和第二个 5 之和为 10。"
    },
    {
      "input": "[100000]\n200000",
      "expected_output": "[]",
      "is_hidden": false,
      "explanation": "单个元素 100000，目标和 200000，无法构成两个不同位置的数。"
    },
    {
      "input": "[]\n0",
      "expected_output": "[]",
      "is_hidden": false,
      "explanation": "空数组，无法计算。"
    },
    {
      "input": "[-3,3]\n0",
      "expected_output": "[0, 1]",
      "is_hidden": false,
      "explanation": "-3 + 3 = 0。"
    },
    {
      "input": "[1,5,3]\n4",
      "expected_output": "[0, 2]",
      "is_hidden": false,
      "explanation": "1 + 3 = 4。"
    }
  ],
  "solution": "class Solution:\n    def twoSum(self, nums, target):\n        hash_map = {}\n        for i, num in enumerate(nums):\n            complement = target - num\n            if complement in hash_map:\n                return [hash_map[complement], i]\n            hash_map[num] = i\n        return []",
  "time_complexity": "O(n)",
  "space_complexity": "O(n)"
}